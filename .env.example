# Obligatorii
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
AUTH_SECRET=schimba-cu-un-secret-lung-si-aleator

# Opționale: sesiunea persistentă a cetățeanului
# Access token scurt, în secunde (implicit 900 = 15 minute)
USER_ACCESS_TOKEN_TTL_SECONDS=900
# Sesiunea se prelungește la fiecare utilizare (implicit 365 zile de inactivitate)
USER_REFRESH_TOKEN_DAYS=365

# Necesare doar pentru contul de administrator
ADMIN_EMAIL=admin@avarii.ro
ADMIN_PASSWORD=schimba-cu-o-parola-puternica

# Opționale: Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Opționale: directoare personalizate
UPLOAD_DIR=


# Opționale: notificări Web Push (toate trei sunt necesare pentru activare)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
